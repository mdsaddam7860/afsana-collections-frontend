# Backend API
# NEXT_PUBLIC_ is exposed to the browser bundle — use it for the URL any
# client-side fetch needs. API_BASE_URL is server-only and can point at
# an internal host (e.g. Docker network address) if that differs.
## Postman collection's baseUrl is "http://localhost:4000/api" — note the
## /api prefix, easy to drop by accident.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
API_BASE_URL=http://localhost:4000/api

# Set to "false" once your backend at the URLs above is ready to serve
# real data — see src/lib/api.ts and src/lib/admin-api.ts.
NEXT_PUBLIC_USE_MOCK_API=false

# Cloudinary — image src is built as `${base}/<imageName>`, e.g.
# cldUrl("product-scrunchie-1.jpg") — see src/lib/cloudinary.ts.
# Include your Cloudinary cloud name + any transformation string
# (f_auto,q_auto is recommended for auto format/compression) up to the
# point right before the filename.
NEXT_PUBLIC_CLOUDINARY_BASE_URL=https://res.cloudinary.com/your-cloud-name/image/upload/f_auto,q_auto

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (for "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
